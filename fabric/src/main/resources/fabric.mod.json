{
  "schemaVersion": 1,
  "id": "reterraforged",
  "version": "${version}",
  "name": "TerraForged Revival",
  "description": "An independent, unofficial TerraForged revival for Minecraft Java 26.2. Development build.",
  "authors": [
	"dags",
	"Won-Ton",
	"racoonman2",
	"TerraForged 26.2 contributors"
  ],
  "contact": {
    "sources": "https://github.com/TheApple05/TerraForged-26.2",
    "issues": "https://github.com/TheApple05/TerraForged-26.2/issues"
  },
  "license": ["MIT", "LGPL-2.1-only"],
  "environment": "*",
  "entrypoints": {
    "main": [
      "raccoonman.reterraforged.fabric.RTFFabric"
    ],
    "fabric-datagen": [
      "raccoonman.reterraforged.fabric.RTFFabric"
    ]
  },
  "depends": {
    "fabricloader": ">=0.20.1",
    "fabric-api": ">=0.161.0+26.2",
    "minecraft": "26.2",
    "java": ">=25"
